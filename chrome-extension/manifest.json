{
  "manifest_version": 3,
  "name": "Billete - Amadeus翻译助手",
  "version": "1.0.0",
  "description": "自动读取Amadeus PNR内容并翻译成中文行程",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "https://sellingplatformconnect.amadeus.com/*",
    "https://*.amadeus.net/*",
    "https://*.amadeus.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sellingplatformconnect.amadeus.com/*",
        "https://*.amadeus.net/*",
        "https://*.amadeus.com/*"
      ],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://sellingplatformconnect.amadeus.com/*",
        "https://*.amadeus.net/*",
        "https://*.amadeus.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Billete翻译",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
